+  test('streams assistant text published through agent/assistant-stream', async () => {
+    const listeners = new Map<string, (...args: unknown[]) => void>();
+    const sessionId = { current: '' };
+    const handle = {
+      agent: {
+        session: { seq: 0 },
+        whenIdle: async () => {},
+        followup: async () => {
+          const stream = listeners.get('agent/assistant-stream');
+          const agent = { session: { id: sessionId.current } };
+          stream?.({ agent: { session: { id: 'other-session' } }, frame: { type: 'chunk', chunk: { type: 'text-delta', index: 0, text: 'ignored' } } });
+          stream?.({ agent, frame: { type: 'start' } });
+          stream?.({ agent, frame: { type: 'chunk', chunk: { type: 'reasoning-delta', index: 0, text: 'think' } } });
+          stream?.({ agent, frame: { type: 'chunk', chunk: { type: 'text-delta', index: 1, text: 'O' } } });
+          stream?.({ agent, frame: { type: 'chunk', chunk: { type: 'text-delta', index: 1, text: 'K' } } });
+          stream?.({ agent, frame: { type: 'end' } });
+        },
+        cancel: () => {},
+      },
+      dispose: async () => {},
+    };
+    const ctx = {
+      agentDefaultModel: {
+        currentSelection: () => ({ provider: 'deepseek-official', model: 'deepseek-chat' }),
+      },
+      agents: {
+        create: async ({ sessionId: id }: { sessionId: string }) => {
+          sessionId.current = id;
+          return handle;
+        },
+      },
+      on: (name: string, listener: (...args: unknown[]) => void) => {
+        listeners.set(name, listener);
+        return () => listeners.delete(name);
+      },
+      sessions: { flush: async () => {} },
+    };
+    const input = new PassThrough();
+    const chunks: string[] = [];
+    const serving = internals.serve(
+      ctx as never,
+      { write: (chunk: string) => chunks.push(chunk) },
+      () => {},
+      input,
+      (exit) => exit(0),
+    );
+
+    input.end(`${JSON.stringify({
+      v: 1,
+      type: 'execute',
+      request_id: 'run-live-stream',
+      cwd: '/project',
+      prompt: 'say OK',
+      mcp_servers: [],
+    })}\n`);
+    await serving;
+
+    const frames = chunks.map((chunk) => JSON.parse(chunk) as { type: string; content?: string; output?: string });
+    assert.deepEqual(
+      frames.filter((frame) => frame.type === 'text' || frame.type === 'thinking').map((frame) => [frame.type, frame.content]),
+      [['thinking', 'think'], ['text', 'O'], ['text', 'K']],
+    );
+    assert.equal(frames.at(-1)?.type, 'result');
+    assert.equal(frames.at(-1)?.output, 'OK');
+    assert.equal(listeners.has('agent/assistant-stream'), false);
+  });
